{
  "name": "teaching-auth-system",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit": "node --test tests/unit.test.mjs tests/budget.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-teaching-auth --only firestore,storage \"node --test --test-concurrency=1 tests/rules.test.mjs\"",
    "test:functions": "firebase emulators:exec --project demo-teaching-auth --only auth,firestore,functions \"node --test tests/functions.test.mjs\"",
    "build:site": "node scripts/build-site.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0",
    "cheerio": "^1.1.0"
  }
}

